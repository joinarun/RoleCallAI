ROLECALL_ENV=local
ROLECALL_PUBLIC_BASE_URL=http://localhost:5173
ROLECALL_API_BASE_URL=http://localhost:8000
ROLECALL_REPOSITORY=memory
ROLECALL_COOKIE_SECURE=false
ROLECALL_COOKIE_SIGNING_KEY=replace-with-at-least-32-random-bytes
ROLECALL_PROJECT_ID=your-gcp-project-id
ROLECALL_REGION=europe-west4
ROLECALL_FIRESTORE_DATABASE=rolecall-dev
ROLECALL_LIVEKIT_URL=ws://localhost:7880
ROLECALL_LIVEKIT_API_KEY=replace-with-local-livekit-api-key
ROLECALL_LIVEKIT_API_SECRET=replace-with-local-livekit-secret-at-least-32-bytes
ROLECALL_LIVE_MODEL=gemini-live-2.5-flash-native-audio
ROLECALL_SUMMARY_MODEL=gemini-3.7-flash
ROLECALL_SUMMARY_MODEL_LOCATION=eu
ROLECALL_AGENT_ENGINE_ID=
ROLECALL_CLOSING_PLAYOUT_TIMEOUT_SECONDS=45
# Enable only when the runtime service account can publish to the configured Pub/Sub topics.
ROLECALL_IMMEDIATE_OUTBOX_PUBLISH=false
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west4
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
VITE_API_BASE_URL=http://localhost:8000
VITE_LIVEKIT_URL=ws://localhost:7880
