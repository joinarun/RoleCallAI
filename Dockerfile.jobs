FROM python:3.13-slim
ARG UV_VERSION=0.8.13
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates clamav clamav-freshclam \
    && freshclam --stdout \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "uv==${UV_VERSION}"
ENV UV_PROJECT_ENVIRONMENT=/opt/rolecall-venv \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080
WORKDIR /workspace/services/rolecall-agent
COPY services/rolecall-agent/pyproject.toml services/rolecall-agent/uv.lock services/rolecall-agent/README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY services/rolecall-agent/app ./app
RUN uv sync --frozen --no-dev
USER 65532:65532
EXPOSE 8080
CMD ["/opt/rolecall-venv/bin/uvicorn", "app.job_api:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers"]
