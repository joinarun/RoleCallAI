FROM node:22-bookworm-slim AS web
WORKDIR /workspace/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM python:3.13-slim AS runtime
ARG UV_VERSION=0.8.13
RUN pip install --no-cache-dir "uv==${UV_VERSION}"
ENV UV_PROJECT_ENVIRONMENT=/opt/rolecall-venv \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080
WORKDIR /workspace/services/rolecall-agent
COPY services/rolecall-agent/pyproject.toml services/rolecall-agent/uv.lock services/rolecall-agent/README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY services/rolecall-agent/app ./app
COPY --from=web /workspace/apps/web/dist /workspace/apps/web/dist
RUN uv sync --frozen --no-dev
USER 65532:65532
EXPOSE 8080
CMD ["/opt/rolecall-venv/bin/uvicorn", "app.fast_api_app:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers"]
