# Non-secret deployment coordinates used by the guarded lifecycle scripts.
# Copy this file to .rolecall.local.env and replace every placeholder.
# The local file is ignored by Git.

ROLECALL_GCP_PROJECT_ID=your-gcp-project-id
ROLECALL_GCP_REGION=europe-west4
ROLECALL_GCP_ZONE=europe-west4-a
ROLECALL_GKE_CLUSTER=rolecall-dev
ROLECALL_FIRESTORE_DATABASE=rolecall-dev
ROLECALL_DEFAULT_FIRESTORE_LOCATION=your-existing-default-database-location
ROLECALL_CONTROL_SERVICE=rolecall-dev-control
ROLECALL_CONTROL_URL=https://your-control-service.run.app
ROLECALL_LIVEKIT_HOST=livekit.your-ip.sslip.io
ROLECALL_BUILD_SERVICE_ACCOUNT_EMAIL=rolecall-build-dev@your-gcp-project-id.iam.gserviceaccount.com
